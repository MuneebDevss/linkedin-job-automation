HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/jobs.sqlite
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/linkedin-job
N8N_TIMEOUT_MS=20000
URL_RESOLUTION_TIMEOUT_MS=8000
# Optional on a loopback-only installation. If set, the extension must send it as X-API-Key.
API_TOKEN=
PROFILE_PATH=./data/profile.json
PROFILE_TEMPLATE_PATH=./data/profile.json
# Gemini is used only for questions that the verified profile, approved
# suggestions, and deterministic rules cannot answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
# Google Forms automation. Keep FORM_ALLOW_LOCALHOST disabled outside tests.
FORM_AUTOMATION_ENABLED=true
FORM_AUTO_SUBMIT=true
FORM_ALLOW_LOCALHOST=false
FORM_TIMEOUT_MS=90000
FORM_NAVIGATION_TIMEOUT_MS=30000
FORM_MAX_RETRIES=1
FORM_MAX_PAGES=10
FORM_ARTIFACTS_DIRECTORY=./data/form-artifacts
RESUME_DIRECTORY=/files/resumes
APPLICATION_DOCUMENTS_DIRECTORY=/files/resumes
FORM_AUTH_STATE_PATH=./data/playwright/google-storage-state.json
# Change this to a trusted HTTPS identity-provider login page when Google Workspace redirects through SSO.
FORM_AUTH_LOGIN_URL=https://accounts.google.com/
FORM_AUTH_LOGIN_TIMEOUT_MS=300000
# Optional desktop-only connection to a separately launched Chrome with a dedicated profile.
# Only unauthenticated loopback HTTP origins are accepted. Do not expose this port or configure it in Compose.
FORM_AUTH_CDP_URL=
PLAYWRIGHT_HEADLESS=true
# Optional: use a managed Chromium executable instead of Playwright's bundled browser.
PLAYWRIGHT_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Optional backend-owned synchronization for form applications. n8n remains responsible for email rows.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=1CgddJkp...SgniBjPWbMduwA
GOOGLE_SHEETS_TAB=Applications
# Recommended: a service-account JSON file shared only with the tracker spreadsheet.
# This path works locally and through the existing Compose data/playwright bind mount.
GOOGLE_SHEETS_CREDENTIALS_PATH=./data/playwright/google-service-account.json
# Short-lived access tokens are supported for development only; do not commit one.
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SHEETS_TIMEOUT_MS=15000
