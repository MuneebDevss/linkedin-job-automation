{
  "manifest_version": 3,
  "name": "Job Post \u2192 n8n",
  "version": "0.3.0",
  "description": "Preview a LinkedIn job post and send it to the local automation backend.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-post-n8n@local.example"
    }
  }
}
