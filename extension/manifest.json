{
  "manifest_version": 3,
  "name": "Job Post \u2192 n8n",
  "version": "0.1.0",
  "description": "Preview one LinkedIn post and manually send it to local n8n.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5678/*",
    "http://127.0.0.1:5678/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "job-post-n8n@local.example"
    }
  }
}